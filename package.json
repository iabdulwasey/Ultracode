{
  "name": "ultracode",
  "version": "1.0.0",
  "description": "Build full-stack applications through natural language conversations. Ultracode enables developers and non-developers alike to create production-ready web applications using AI-powered code generation.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:setup": "cd packages/database && npm run setup",
    "db:migrate": "cd packages/database && npm run migrate",
    "db:seed": "cd packages/database && npm run seed"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@9.8.1",
  "keywords": [
    "ai",
    "code-generation",
    "app-builder",
    "full-stack",
    "react",
    "typescript"
  ],
  "author": "Ultracode Team",
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.5",
    "@supabase/supabase-js": "^2.52.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "axios": "^1.10.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "remark-gfm": "^4.0.1"
  }
}
