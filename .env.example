# Ultracode Environment Variables

# Application
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000/api
WS_URL=ws://localhost:3000/ws
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ultracode
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Anthropic Configuration (Primary AI Model)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI Configuration (Optional - for fallback)
OPENAI_API_KEY=sk-...
OPENAI_ORGANIZATION=org-...

# Supabase Integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# GitHub Integration
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_FREE_PLAN_PRICE_ID=price_...
STRIPE_LITE_PLAN_PRICE_ID=price_...
STRIPE_PRO_PLAN_PRICE_ID=price_...

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=ultracode-projects

# Deployment Providers
NETLIFY_ACCESS_TOKEN=your-netlify-token
VERCEL_ACCESS_TOKEN=your-vercel-token

# Email Service (SendGrid)
SENDGRID_API_KEY=SG....
FROM_EMAIL=noreply@ultracode.dev
SUPPORT_EMAIL=support@ultracode.dev

# Monitoring & Analytics
SENTRY_DSN=https://...@sentry.io/...
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://app.posthog.com

# Security
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_GITHUB_SYNC=true
ENABLE_SUPABASE_INTEGRATION=true
ENABLE_PREMIUM_MODELS=false
ENABLE_TEAM_COLLABORATION=true

# Cache Configuration
CACHE_TTL=3600
PROMPT_CACHE_TTL=86400
SESSION_TTL=604800

# File Upload Limits
MAX_FILE_SIZE=10485760
MAX_PROJECT_SIZE=1073741824
MAX_FILES_PER_PROJECT=1000

# Generation Limits
MAX_PROMPT_LENGTH=4000
MAX_TOKENS_PER_REQUEST=8000
GENERATION_TIMEOUT_MS=60000

# Deployment Configuration
BUILD_TIMEOUT_MS=900000
DEPLOY_TIMEOUT_MS=300000

# Development Only
VITE_MOCK_API=false
VITE_ENABLE_DEVTOOLS=true